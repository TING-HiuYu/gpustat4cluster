[Unit]
Description=gpustat4cluster server daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
User=gpustat4cluster
Group=gpustat4cluster
Environment=GPUSTAT4CLUSTER_CONFIG=/etc/gpustat4cluster/server.toml
ExecStart=/usr/local/bin/gpustat4cluster-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StateDirectory=gpustat4cluster
LogsDirectory=gpustat4cluster
RuntimeDirectory=gpustat4cluster
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
